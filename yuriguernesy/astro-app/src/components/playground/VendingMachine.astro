---
interface Props {
  email: string;
}
const { email } = Astro.props;

const ITEMS = [
  { code: "A1", name: "Web app", blurb: "Full-stack web app, API or internal tool", color: "#ffe600" },
  { code: "A2", name: "Mobile app", blurb: "iOS, Android or Flutter", color: "#0ea5e9" },
  { code: "A3", name: "AI & automation", blurb: "LLM workflows, n8n, agents", color: "#a855f7" },
  { code: "A4", name: "Embedded / IoT", blurb: "Sensors, firmware, connected devices", color: "#22c55e" },
  { code: "B1", name: "Hardware prototype", blurb: "PCBs, Raspberry Pi, Arduino, enclosures", color: "#f97316" },
  { code: "B2", name: "Hire Yuri", blurb: "A full-time or contract role", color: "#ff4d2e" },
  { code: "B3", name: "Collab", blurb: "Build something together", color: "#f472b6" },
  { code: "B4", name: "Something weird", blurb: "Slightly unhinged. Let's talk.", color: "#f4f4ef" },
];
---

<div class="vm" data-email={email}>
  <div class="vm-cabinet yg-noinvert">
    <div class="vm-header">
      <span>HIRE-O-MATIC</span>
      <small>by Legocia Ltd</small>
    </div>

    <div class="vm-body">
      <div class="vm-glass">
        <ul class="vm-grid" role="list">
          {
            ITEMS.map((it) => (
              <li class="vm-slot" data-code={it.code}>
                <button
                  type="button"
                  class="vm-item"
                  style={`--c:${it.color}`}
                  data-code={it.code}
                  data-name={it.name}
                  data-blurb={it.blurb}
                  aria-label={`${it.code}: ${it.name}. ${it.blurb}`}
                >
                  <span class="vm-pack">
                    <strong>{it.name}</strong>
                    <small>{it.blurb}</small>
                  </span>
                </button>
                <span class="vm-coil" aria-hidden="true" />
                <span class="vm-tag" aria-hidden="true">
                  {it.code} · 1 coin
                </span>
              </li>
            ))
          }
        </ul>
        <button type="button" class="vm-tray" aria-label="Pick up your order" disabled>
          <span class="vm-tray__flap">PUSH</span>
          <span class="vm-tray__capsule" aria-hidden="true" />
        </button>
      </div>

      <div class="vm-panel">
        <div class="vm-display" aria-live="polite">INSERT COIN</div>
        <button type="button" class="vm-coin-slot" aria-label="Insert a coin">
          <span class="vm-coin-slot__mouth" aria-hidden="true" />
          <span class="vm-coin" aria-hidden="true">¢</span>
          <small>Insert coin</small>
        </button>
        <div class="vm-keypad" role="group" aria-label="Keypad">
          {ITEMS.map((it) => <button type="button" data-code={it.code}>{it.code}</button>)}
        </div>
        <p class="vm-credit">Free play. Coins are on the house.</p>
      </div>
    </div>
  </div>

  <div class="vm-order" hidden role="dialog" aria-label="Your order">
    <div class="vm-order__card">
      <button type="button" class="vm-order__close" aria-label="Close">×</button>
      <span class="vm-order__eyebrow">Capsule opened</span>
      <strong class="vm-order__title"></strong>
      <p class="vm-order__blurb"></p>
      <pre class="vm-order__email"></pre>
      <div class="vm-order__actions">
        <a class="vm-order__send" href="#">Send to Yuri</a>
        <button type="button" class="vm-order__copy">Copy message</button>
      </div>
    </div>
  </div>
</div>

<script>
  import { printReceipt } from "./printer";

  function sound(kind: "coin" | "motor" | "thunk" | "error") {
    try {
      const Ctx = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
      const ctx = new Ctx();
      const g = ctx.createGain();
      g.connect(ctx.destination);
      const o = ctx.createOscillator();
      const t = ctx.currentTime;
      if (kind === "coin") {
        o.type = "square";
        o.frequency.setValueAtTime(988, t);
        o.frequency.setValueAtTime(1319, t + 0.08);
        g.gain.setValueAtTime(0.05, t);
        g.gain.exponentialRampToValueAtTime(0.001, t + 0.35);
        o.start(t);
        o.stop(t + 0.35);
      } else if (kind === "motor") {
        o.type = "sawtooth";
        o.frequency.value = 70;
        g.gain.value = 0.04;
        o.start(t);
        o.stop(t + 1.1);
      } else if (kind === "thunk") {
        o.type = "sine";
        o.frequency.setValueAtTime(160, t);
        o.frequency.exponentialRampToValueAtTime(40, t + 0.2);
        g.gain.setValueAtTime(0.25, t);
        g.gain.exponentialRampToValueAtTime(0.001, t + 0.25);
        o.start(t);
        o.stop(t + 0.25);
      } else {
        o.type = "square";
        o.frequency.value = 140;
        g.gain.value = 0.05;
        o.start(t);
        o.stop(t + 0.25);
      }
      o.connect(g);
      window.setTimeout(() => ctx.close(), 1400);
    } catch {
      /* no audio */
    }
  }

  function initVending() {
    const root = document.querySelector<HTMLElement>(".vm");
    if (!root || root.dataset.ready) return;
    root.dataset.ready = "1";
    const email = root.dataset.email || "";
    const display = root.querySelector<HTMLElement>(".vm-display")!;
    const coinBtn = root.querySelector<HTMLButtonElement>(".vm-coin-slot")!;
    const tray = root.querySelector<HTMLButtonElement>(".vm-tray")!;
    const order = root.querySelector<HTMLElement>(".vm-order")!;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let credit = 0;
    let busy = false;
    let pending: HTMLButtonElement | null = null;
    let flashTimer = 0;

    const say = (text: string, flash = false) => {
      display.textContent = text;
      display.classList.toggle("is-flash", flash);
      window.clearTimeout(flashTimer);
      if (flash) {
        flashTimer = window.setTimeout(() => {
          display.classList.remove("is-flash");
          display.textContent = credit ? "CREDIT 1 · SELECT" : "INSERT COIN";
        }, 1600);
      }
    };

    coinBtn.addEventListener("click", () => {
      if (busy) return;
      if (credit) return say("CREDIT 1 · SELECT", true);
      coinBtn.classList.remove("is-dropping");
      void coinBtn.offsetWidth;
      coinBtn.classList.add("is-dropping");
      sound("coin");
      credit = 1;
      window.setTimeout(() => say("CREDIT 1 · SELECT"), reduce ? 0 : 350);
    });

    function vend(code: string) {
      if (busy) return;
      const item = root!.querySelector<HTMLButtonElement>(`.vm-item[data-code="${code}"]`);
      if (!item) return;
      if (!credit) {
        sound("error");
        return say("INSERT COIN FIRST", true);
      }
      busy = true;
      credit = 0;
      say(`VENDING ${code}...`);
      const slot = item.closest<HTMLElement>(".vm-slot")!;
      slot.classList.add("is-vending");
      sound("motor");
      window.setTimeout(
        () => {
          slot.classList.add("is-dropped");
          sound("thunk");
          tray.disabled = false;
          tray.classList.add("has-item");
          tray.style.setProperty("--c", item.style.getPropertyValue("--c"));
          pending = item;
          say("TAKE YOUR ITEM");
          busy = false;
        },
        reduce ? 50 : 1150
      );
    }

    root.querySelectorAll<HTMLButtonElement>(".vm-item").forEach((b) => b.addEventListener("click", () => vend(b.dataset.code!)));
    root.querySelectorAll<HTMLButtonElement>(".vm-keypad button").forEach((b) => b.addEventListener("click", () => vend(b.dataset.code!)));

    tray.addEventListener("click", () => {
      if (!pending) return;
      const item = pending;
      pending = null;
      tray.disabled = true;
      tray.classList.remove("has-item");
      const slot = item.closest<HTMLElement>(".vm-slot")!;
      // restock after a moment so the machine is never empty
      window.setTimeout(() => slot.classList.remove("is-vending", "is-dropped"), 900);
      say("THANK YOU");
      window.setTimeout(() => say("INSERT COIN"), 1800);

      const name = item.dataset.name || "";
      const subject = `Vending machine order: ${name}`;
      const body = `Hi Yuri,\n\nI got a "${name}" out of your vending machine.\n\nWhat I'd like to build or talk about:\n\n\nTimeline:\n\nBudget (if it's a project):\n\nBest way to reach me:\n`;
      order.querySelector(".vm-order__title")!.textContent = name;
      order.querySelector(".vm-order__blurb")!.textContent = item.dataset.blurb || "";
      order.querySelector(".vm-order__email")!.textContent = `To: ${email}\nSubject: ${subject}\n\n${body}`;
      order.querySelector<HTMLAnchorElement>(".vm-order__send")!.href =
        `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      const copy = order.querySelector<HTMLButtonElement>(".vm-order__copy")!;
      copy.textContent = "Copy message";
      copy.onclick = async () => {
        try {
          await navigator.clipboard.writeText(`${subject}\n\n${body}`);
          copy.textContent = "Copied";
        } catch {
          copy.textContent = "Couldn't copy";
        }
      };
      order.hidden = false;
      order.querySelector<HTMLElement>(".vm-order__send")!.focus();
      printReceipt("Hire-o-matic", [[`1x ${name}`, "1 COIN"]], "Yuri will be in touch");
    });

    const close = () => (order.hidden = true);
    order.querySelector(".vm-order__close")!.addEventListener("click", close);
    order.addEventListener("click", (e) => {
      if (e.target === order) close();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !order.hidden) close();
    });
  }
  document.addEventListener("astro:page-load", initVending);
  initVending();
</script>

<style>
  .vm {
    display: grid;
    justify-items: center;
  }
  .vm-cabinet {
    width: min(760px, 100%);
    padding: 16px;
    border-radius: 18px;
    background: linear-gradient(180deg, #1d1d1d, #111);
    box-shadow:
      inset 0 0 0 2px #2a2a2a,
      inset 0 0 0 8px #151515,
      0 30px 60px rgba(0, 0, 0, 0.55);
  }
  .vm-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 16px;
    margin-bottom: 14px;
    border-radius: 10px;
    background: var(--accent);
    color: #0b0b0b;
  }
  .vm-header span {
    font-size: clamp(1.3rem, 3.4vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.04em;
  }
  .vm-header small {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .vm-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 170px;
    gap: 14px;
  }

  /* ---- glass + items ---- */
  .vm-glass {
    position: relative;
    padding: 12px 12px 0;
    border-radius: 10px;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.01) 40%), #0a0a0a;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }
  .vm-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .vm-slot {
    position: relative;
    display: grid;
    gap: 4px;
    padding-bottom: 6px;
    border-bottom: 3px solid #2b2b2b;
  }
  .vm-item {
    position: relative;
    z-index: 1;
    min-height: 98px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    transition: transform 160ms ease;
  }
  .vm-item:hover,
  .vm-item:focus-visible {
    transform: translateY(-3px);
  }
  .vm-pack {
    display: grid;
    align-content: center;
    gap: 4px;
    height: 100%;
    min-height: 98px;
    padding: 10px 8px;
    border-radius: 8px 8px 4px 4px;
    background: linear-gradient(160deg, color-mix(in srgb, var(--c) 92%, #fff), var(--c));
    color: #0b0b0b;
    text-align: center;
    box-shadow: inset 0 -6px 0 rgba(0, 0, 0, 0.12), 0 6px 10px rgba(0, 0, 0, 0.35);
  }
  .vm-pack strong {
    font-size: 0.86rem;
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }
  .vm-pack small {
    font-size: 0.64rem;
    line-height: 1.25;
    opacity: 0.8;
  }
  .vm-coil {
    position: absolute;
    left: 6%;
    right: 6%;
    bottom: 22px;
    height: 16px;
    background: repeating-linear-gradient(70deg, #9c9c9c 0 3px, transparent 3px 11px);
    opacity: 0.8;
  }
  .vm-tag {
    position: relative;
    z-index: 1;
    color: var(--accent);
    font: 700 0.62rem/1 ui-monospace, Menlo, monospace;
    letter-spacing: 0.06em;
    text-align: center;
  }
  .vm-slot.is-vending .vm-coil {
    animation: vm-coil 0.35s linear 3;
  }
  @keyframes vm-coil {
    to {
      background-position: 11px 0;
    }
  }
  .vm-slot.is-vending .vm-item {
    transform: translateY(6px);
    transition: transform 1s linear;
  }
  .vm-slot.is-dropped .vm-item {
    animation: vm-drop 520ms cubic-bezier(0.5, 0, 0.9, 0.5) forwards;
  }
  @keyframes vm-drop {
    to {
      transform: translateY(420px) rotate(14deg);
      opacity: 0;
    }
  }

  .vm-tray {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 54px;
    margin-top: 12px;
    border: 0;
    border-top: 2px solid #2b2b2b;
    background: #050505;
    cursor: pointer;
  }
  .vm-tray:disabled {
    cursor: default;
  }
  .vm-tray__flap {
    color: rgba(255, 255, 255, 0.35);
    font: 700 0.7rem/1 ui-monospace, Menlo, monospace;
    letter-spacing: 0.3em;
  }
  .vm-tray__capsule {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 64px;
    height: 30px;
    margin: -15px 0 0 -32px;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--c, #ffe600) 50%, rgba(255, 255, 255, 0.85) 50%);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);
    opacity: 0;
    transform: translateY(-20px);
  }
  .vm-tray.has-item .vm-tray__capsule {
    opacity: 1;
    transform: none;
    transition: transform 260ms cubic-bezier(0.3, 1.6, 0.5, 1), opacity 120ms;
    animation: vm-wiggle 1.2s ease-in-out 400ms infinite;
  }
  .vm-tray.has-item .vm-tray__flap {
    opacity: 0;
  }
  @keyframes vm-wiggle {
    0%,
    100% {
      transform: rotate(0);
    }
    20% {
      transform: rotate(-6deg);
    }
    40% {
      transform: rotate(5deg);
    }
  }

  /* ---- control panel ---- */
  .vm-panel {
    display: grid;
    align-content: start;
    gap: 12px;
    padding: 12px;
    border-radius: 10px;
    background: #1a1a1a;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
  }
  .vm-display {
    min-height: 42px;
    display: grid;
    place-items: center;
    padding: 6px;
    border-radius: 4px;
    background: #140404;
    color: #ff4d2e;
    font: 700 0.78rem/1.2 ui-monospace, Menlo, monospace;
    letter-spacing: 0.08em;
    text-align: center;
    text-shadow: 0 0 8px rgba(255, 77, 46, 0.8);
  }
  .vm-display.is-flash {
    animation: vm-flash 0.3s steps(2) 4;
  }
  @keyframes vm-flash {
    50% {
      opacity: 0.2;
    }
  }
  .vm-coin-slot {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 6px;
    padding: 10px 6px 8px;
    border: 1px solid #333;
    border-radius: 8px;
    background: #222;
    color: rgba(255, 255, 255, 0.7);
    font: inherit;
    cursor: pointer;
    overflow: hidden;
  }
  .vm-coin-slot small {
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .vm-coin-slot__mouth {
    width: 6px;
    height: 30px;
    border-radius: 3px;
    background: #000;
    box-shadow: 0 0 0 3px #3a3a3a;
  }
  .vm-coin {
    position: absolute;
    left: 50%;
    top: 8px;
    width: 26px;
    height: 26px;
    margin-left: -13px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #fff3a0, #e6b800 60%, #a37f00);
    color: #6b5200;
    font-weight: 700;
    font-size: 0.8rem;
    opacity: 0;
    pointer-events: none;
  }
  .vm-coin-slot:hover .vm-coin {
    opacity: 1;
    transform: translateX(26px) rotate(-20deg);
    transition: transform 160ms ease, opacity 120ms;
  }
  .vm-coin-slot.is-dropping .vm-coin {
    animation: vm-coin-in 360ms ease-in forwards;
  }
  @keyframes vm-coin-in {
    0% {
      opacity: 1;
      transform: translateX(26px) rotate(-20deg);
    }
    50% {
      opacity: 1;
      transform: translateX(0) rotateY(80deg);
    }
    100% {
      opacity: 0;
      transform: translateY(18px) rotateY(88deg) scaleX(0.2);
    }
  }
  .vm-keypad {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
  }
  .vm-keypad button {
    padding: 8px 0;
    border: 0;
    border-radius: 6px;
    background: #2e2e2e;
    color: #eee;
    font: 700 0.72rem/1 ui-monospace, Menlo, monospace;
    cursor: pointer;
    box-shadow: 0 3px 0 #111;
  }
  .vm-keypad button:active {
    transform: translateY(2px);
    box-shadow: 0 1px 0 #111;
  }
  .vm-credit {
    margin: 0;
    color: rgba(255, 255, 255, 0.4);
    font-size: 0.7rem;
    line-height: 1.35;
  }

  /* ---- order card ---- */
  .vm-order {
    position: fixed;
    inset: 0;
    z-index: 95;
    display: grid;
    place-items: center;
    padding: 20px;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(3px);
  }
  .vm-order[hidden] {
    display: none;
  }
  .vm-order__card {
    position: relative;
    width: min(520px, 100%);
    max-height: 90vh;
    overflow: auto;
    display: grid;
    gap: 10px;
    padding: 22px;
    border-radius: 16px;
    border: 1px solid var(--line);
    background: #0f0f0f;
    animation: vm-pop 300ms cubic-bezier(0.3, 1.5, 0.5, 1);
  }
  @keyframes vm-pop {
    from {
      transform: scale(0.8);
      opacity: 0;
    }
  }
  .vm-order__close {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 32px;
    height: 32px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: none;
    color: inherit;
    font-size: 1.2rem;
    cursor: pointer;
  }
  .vm-order__eyebrow {
    color: var(--muted);
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .vm-order__title {
    font-size: 1.8rem;
    line-height: 1;
    letter-spacing: -0.05em;
    text-transform: uppercase;
  }
  .vm-order__blurb {
    margin: 0;
    color: var(--muted);
  }
  .vm-order__email {
    margin: 4px 0 0;
    padding: 12px;
    border-radius: 10px;
    background: #050505;
    border: 1px solid var(--line-soft);
    color: rgba(244, 244, 239, 0.85);
    font: 0.78rem/1.5 ui-monospace, Menlo, monospace;
    white-space: pre-wrap;
  }
  .vm-order__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .vm-order__send,
  .vm-order__copy {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding: 0 16px;
    border-radius: 999px;
    font: 700 0.78rem/1 "Space Grotesk", system-ui, sans-serif;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
  }
  .vm-order__send {
    background: var(--accent);
    color: #0b0b0b;
  }
  .vm-order__copy {
    border: 1px solid var(--line);
    background: none;
    color: inherit;
  }

  @media (max-width: 720px) {
    .vm-body {
      grid-template-columns: 1fr;
    }
    .vm-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .vm-panel {
      grid-template-columns: 1fr 1fr;
    }
    .vm-display,
    .vm-keypad,
    .vm-credit {
      grid-column: 1 / -1;
    }
  }
</style>
