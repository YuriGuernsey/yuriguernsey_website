---
// The site's toys: sticker sheet + shared board, BuffBuddy, solder cursor,
// pick-and-place headline, PCB traces, light switch and easter eggs.
// All of it is progressive enhancement: without JS the page is unchanged.
const solderCursor = `url("data:image/svg+xml,${encodeURIComponent(
  "<svg xmlns='http://www.w3.org/2000/svg' width='32' height='32' viewBox='0 0 32 32'>" +
    "<g stroke-linecap='round'>" +
    "<line x1='29' y1='3' x2='19' y2='13' stroke='#000' stroke-width='8'/>" +
    "<line x1='19' y1='13' x2='7' y2='25' stroke='#000' stroke-width='5'/>" +
    "<line x1='7' y1='25' x2='3' y2='29' stroke='#000' stroke-width='4'/>" +
    "<line x1='29' y1='3' x2='19' y2='13' stroke='#ffe600' stroke-width='6'/>" +
    "<line x1='26' y1='6' x2='24' y2='8' stroke='#111' stroke-width='6'/>" +
    "<line x1='19' y1='13' x2='7' y2='25' stroke='#c8c8c8' stroke-width='3'/>" +
    "<line x1='7' y1='25' x2='3' y2='29' stroke='#ff7a1a' stroke-width='2'/>" +
    "</g><circle cx='3' cy='29' r='2' fill='#ffd27a'/></svg>"
)}") 3 29, crosshair`;
---

<div class="yg-root" data-solder-cursor={solderCursor}>
  <div class="yg-toasts" aria-live="polite"></div>

  <div class="yg-sheet" id="yg-sheet" role="dialog" aria-label="Settings" hidden>
    <div class="yg-sheet__top">
      <strong>Settings</strong>
      <button type="button" class="yg-sheet__close" aria-label="Close settings">×</button>
    </div>

    <div class="yg-settings__lights"></div>

    <div class="yg-sheet__toggles">
      <label><input type="checkbox" data-toggle="stickers" checked /> Show stickers on page</label>
      <label><input type="checkbox" data-toggle="buddy" /> BuffBuddy (pixel gym buddy)</label>
      <label><input type="checkbox" data-toggle="solder" /> Soldering-iron cursor on hardware work</label>
      <label><input type="checkbox" data-toggle="scope" checked /> Oscilloscope scroll bar</label>
      <button type="button" class="yg-sheet__reboot">Replay boot sequence</button>
    </div>

    <div class="yg-sheet__section">
      <strong>Stickers</strong>
      <p>Drag one onto the page. Flick your own stickers off the page to remove them.</p>
    </div>
    <div class="yg-sheet__grid"></div>
    <p class="yg-sheet__count"></p>
    <p class="yg-sheet__mode">Loading the board...</p>
  </div>

  <button type="button" class="yg-fab" aria-controls="yg-sheet" aria-expanded="false">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
      <circle cx="12" cy="12" r="3.2" fill="none" stroke="currentColor" stroke-width="2"></circle>
      <path
        d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5.3 5.3l2.1 2.1M16.6 16.6l2.1 2.1M5.3 18.7l2.1-2.1M16.6 7.4l2.1-2.1"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"></path>
    </svg>
    Settings
  </button>
</div>

<script>
  import { initStickerBoard } from "./sticker-board";
  import { initBuddy } from "./buddy";
  import { initEasterEggs, initHeroBuild, initLightSwitch, initSolder, initTraces } from "./effects";
  import { initPixelWall } from "./pixel-wall";
  import { initScope } from "./scope";

  function boot() {
    const root = document.querySelector<HTMLElement>(".yg-root");
    if (!root || root.dataset.booted) return;
    root.dataset.booted = "1";
    if (root.dataset.solderCursor) document.documentElement.style.setProperty("--yg-solder-cursor", root.dataset.solderCursor);
    const steps: Array<() => void> = [
      initHeroBuild,
      initTraces,
      () => initLightSwitch(root),
      () => initStickerBoard(root),
      () => initBuddy(root),
      () => initSolder(root),
      initEasterEggs,
      initPixelWall,
      () => initScope(root),
      () =>
        root.querySelector(".yg-sheet__reboot")?.addEventListener("click", () => {
          const boot = (window as unknown as { __ygBoot?: () => void }).__ygBoot;
          root.querySelector<HTMLElement>(".yg-sheet")!.hidden = true;
          boot?.();
        }),
    ];
    // One broken toy should never take the rest of the page down with it.
    for (const step of steps) {
      try {
        step();
      } catch (err) {
        console.error("[playground]", err);
      }
    }
  }

  document.addEventListener("astro:page-load", boot);
  boot();
</script>

<style is:global>
  /* light mode rules live in Layout.astro so the lights stay on site-wide */

  .yg-switch {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-size: 0.76rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .yg-switch__plate {
    position: relative;
    width: 20px;
    height: 28px;
    border-radius: 5px;
    border: 1px solid rgba(255, 255, 255, 0.35);
    background: #161616;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }
  .yg-switch__lever {
    position: absolute;
    left: 50%;
    top: 14px;
    width: 8px;
    height: 10px;
    margin-left: -4px;
    border-radius: 2px;
    background: #f4f4ef;
    box-shadow: 0 2px 0 #8a8a84;
    transition: top 120ms ease;
  }
  .yg-switch[aria-pressed="true"] .yg-switch__lever {
    top: 3px;
    box-shadow: 0 -2px 0 #8a8a84;
  }

  /* ---------- pick-and-place headline ---------- */
  .yg-build {
    position: relative;
  }
  .yg-word {
    display: inline-block;
    white-space: nowrap;
  }
  .yg-chip {
    display: inline-block;
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 230, 0, 0.5);
    transform: translateY(-0.16em) scale(1.06);
    transition:
      color 220ms ease,
      -webkit-text-stroke-color 220ms ease,
      transform 260ms cubic-bezier(0.2, 1.6, 0.4, 1);
  }
  .yg-chip.is-placed {
    color: inherit;
    -webkit-text-stroke-color: transparent;
    transform: none;
  }
  .yg-head {
    position: absolute;
    left: 0;
    top: 0;
    width: 10px;
    height: 16px;
    margin: -20px 0 0 -5px;
    border-radius: 2px 2px 4px 4px;
    background: var(--accent);
    box-shadow: 0 0 14px var(--accent);
    pointer-events: none;
    transition: transform 38ms linear;
  }
  .yg-head::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 100%;
    width: 2px;
    height: 400px;
    margin-left: -1px;
    background: linear-gradient(to top, rgba(255, 230, 0, 0.5), transparent);
  }
  .yg-head.is-done {
    opacity: 0;
    transition: opacity 500ms ease;
  }

  /* ---------- PCB traces ---------- */
  .yg-traces {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
  }
  .yg-traces path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.6;
    stroke-opacity: 0.38;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 120ms linear;
  }
  .yg-traces circle {
    fill: #040404;
    stroke: var(--accent);
    stroke-width: 2;
    opacity: 0;
    transition: opacity 200ms ease;
  }
  .yg-traces circle.is-lit {
    opacity: 0.7;
  }

  /* ---------- solder cursor ---------- */
  .yg-solder,
  .yg-solder * {
    cursor: var(--yg-solder-cursor, crosshair) !important;
  }
  .yg-smoke {
    position: fixed;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(225, 225, 220, 0.55), rgba(225, 225, 220, 0));
    pointer-events: none;
    z-index: 70;
    animation: yg-smoke 1.1s ease-out forwards;
  }
  @keyframes yg-smoke {
    from {
      transform: translate(-6px, 0) scale(0.6);
      opacity: 0.85;
    }
    to {
      transform: translate(var(--drift, 0px), -38px) scale(2.8);
      opacity: 0;
    }
  }

  /* ---------- stickers ---------- */
  .yg-sticker-layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    pointer-events: none;
    z-index: 40;
  }
  .yg-sticker {
    position: absolute;
    line-height: 0;
    transform: translate(-50%, -50%) rotate(var(--rot, 0deg));
    filter: drop-shadow(0 2px 2px rgba(0, 0, 0, 0.35));
    user-select: none;
    -webkit-user-select: none;
    touch-action: none;
    transition:
      transform 160ms ease,
      filter 160ms ease;
  }
  .yg-sticker svg {
    display: block;
    max-width: 150px;
    height: auto;
  }
  .yg-sticker.is-mine {
    pointer-events: auto;
    cursor: grab;
  }
  .yg-sticker.is-mine:hover::after,
  .yg-sticker.is-held::after {
    content: "";
    position: absolute;
    right: 6px;
    bottom: 6px;
    width: 18px;
    height: 18px;
    border-radius: 0 0 9px 0;
    background: linear-gradient(135deg, transparent 50%, #d9d9d4 50%, #ffffff 72%, #c9c9c3);
    box-shadow: -2px -2px 4px rgba(0, 0, 0, 0.25);
  }
  .yg-sticker.is-held::after {
    width: 30px;
    height: 30px;
  }
  .yg-sticker.is-held {
    z-index: 2;
    cursor: grabbing;
    transform: translate(-50%, -50%) rotate(var(--rot, 0deg)) perspective(420px) rotateX(14deg) scale(1.12);
    filter: drop-shadow(0 18px 16px rgba(0, 0, 0, 0.5));
    transition: filter 160ms ease;
  }
  .yg-sticker.is-flying {
    transition: none;
  }
  .yg-sticker.is-landing {
    animation: yg-slap 380ms ease-out;
  }
  @keyframes yg-slap {
    0% {
      transform: translate(-50%, -50%) rotate(var(--rot, 0deg)) scale(1.14);
    }
    45% {
      transform: translate(-50%, -50%) rotate(var(--rot, 0deg)) scale(0.93);
    }
    75% {
      transform: translate(-50%, -50%) rotate(var(--rot, 0deg)) scale(1.03);
    }
    100% {
      transform: translate(-50%, -50%) rotate(var(--rot, 0deg)) scale(1);
    }
  }
  .yg-sticker.is-holo svg,
  .yg-sheet__item.is-holo svg {
    animation: yg-holo 3s linear infinite;
  }
  @keyframes yg-holo {
    to {
      filter: hue-rotate(360deg);
    }
  }
  body.yg-dragging {
    user-select: none;
    -webkit-user-select: none;
    cursor: grabbing;
  }
  @media (max-width: 720px) {
    .yg-sticker svg {
      max-width: 104px;
    }
  }

  /* ---------- sticker sheet UI ---------- */
  .yg-fab {
    position: fixed;
    right: 18px;
    bottom: 18px;
    z-index: 60;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 16px;
    border: 0;
    border-radius: 999px;
    background: var(--accent);
    color: #0b0b0b;
    font: 700 0.78rem/1 "Space Grotesk", system-ui, sans-serif;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45);
    transition: transform 140ms ease;
  }
  .yg-fab:hover {
    transform: translateY(-2px) rotate(-2deg);
  }
  .yg-sheet {
    position: fixed;
    right: 18px;
    bottom: 74px;
    z-index: 60;
    width: min(440px, calc(100vw - 36px));
    max-height: min(72vh, 640px);
    overflow: auto;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: #0d0d0d;
    color: var(--text);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6);
  }
  .yg-sheet[hidden] {
    display: none;
  }
  .yg-sheet__top {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .yg-sheet__top {
    align-items: center;
  }
  .yg-sheet__section {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--line-soft);
  }
  .yg-sheet__section strong {
    font-size: 0.86rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .yg-sheet__section p {
    margin: 4px 0 0;
    color: var(--muted);
    font-size: 0.84rem;
    line-height: 1.45;
  }
  .yg-settings__lights {
    margin-top: 14px;
  }
  .yg-settings__lights .yg-switch {
    width: 100%;
    gap: 12px;
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: 12px;
    text-align: left;
  }
  .yg-switch__hint {
    margin-left: auto;
    color: var(--muted);
    letter-spacing: 0.06em;
    text-transform: none;
    font-size: 0.8rem;
  }
  .yg-sheet__toggles label[hidden] {
    display: none;
  }
  .yg-sheet__top strong {
    font-size: 1.05rem;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }
  .yg-sheet__top p,
  .yg-sheet__count,
  .yg-sheet__mode {
    margin: 4px 0 0;
    color: var(--muted);
    font-size: 0.84rem;
    line-height: 1.45;
  }
  .yg-sheet__count {
    color: var(--accent);
  }
  .yg-sheet__close {
    flex: none;
    width: 32px;
    height: 32px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: none;
    color: inherit;
    font-size: 1.2rem;
    cursor: pointer;
  }
  .yg-sheet__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin: 14px 0 10px;
  }
  .yg-sheet__item {
    display: grid;
    place-items: center;
    min-height: 86px;
    padding: 8px;
    border: 1px dashed rgba(255, 255, 255, 0.16);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.02);
    cursor: grab;
    touch-action: none;
    transition: transform 140ms ease, border-color 140ms ease;
  }
  .yg-sheet__item:hover,
  .yg-sheet__item:focus-visible {
    transform: rotate(-3deg) scale(1.04);
    border-color: var(--accent);
  }
  .yg-sheet__item svg {
    width: 100%;
    max-width: 112px;
    height: auto;
    pointer-events: none;
  }
  .yg-sheet__item.is-locked {
    cursor: not-allowed;
    transform: none;
  }
  .yg-sheet__lock {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 2px dashed rgba(255, 255, 255, 0.25);
    color: rgba(255, 255, 255, 0.4);
    font-size: 1.4rem;
    font-weight: 700;
  }
  .yg-sheet__toggles {
    display: grid;
    gap: 8px;
    margin-top: 12px;
    font-size: 0.86rem;
  }
  .yg-sheet__toggles label {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
  }

  /* ---------- toasts ---------- */
  .yg-toasts {
    position: fixed;
    top: 16px;
    left: 50%;
    z-index: 80;
    display: grid;
    gap: 8px;
    width: min(420px, calc(100vw - 32px));
    transform: translateX(-50%);
    pointer-events: none;
  }
  .yg-toast {
    padding: 12px 16px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: #111;
    color: var(--text);
    font-size: 0.9rem;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5);
    animation: yg-toast-in 260ms ease-out;
    transition: opacity 400ms ease, transform 400ms ease;
  }
  .yg-toast--gold {
    border-color: var(--accent);
    background: #1a1700;
  }
  .yg-toast.is-out {
    opacity: 0;
    transform: translateY(-8px);
  }
  @keyframes yg-toast-in {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
  }

  /* ---------- BuffBuddy ---------- */
  .yg-buddy {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 55;
    width: 56px;
    height: 56px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    will-change: transform;
  }
  .yg-buddy[hidden] {
    display: none;
  }
  .yg-buddy__sprite {
    display: block;
    width: 100%;
    height: 100%;
  }
  .yg-buddy__sprite svg {
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    filter: drop-shadow(0 3px 0 rgba(0, 0, 0, 0.35));
  }
  .yg-buddy__bubble {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 8px);
    transform: translateX(-50%);
    padding: 6px 10px;
    border-radius: 10px;
    background: #f4f4ef;
    color: #0b0b0b;
    font: 700 0.74rem/1.2 "Space Grotesk", system-ui, sans-serif;
    white-space: nowrap;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.4);
  }
  .yg-buddy__bubble::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 100%;
    margin-left: -5px;
    border: 5px solid transparent;
    border-top-color: #f4f4ef;
  }
  .yg-buddy__bubble[hidden] {
    display: none;
  }

  .yg-sheet__reboot {
    justify-self: start;
    margin-top: 4px;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: none;
    color: inherit;
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
  }
  .yg-sheet__reboot:hover {
    border-color: var(--accent);
  }

  /* ---------- guestbook printer ---------- */
  .yg-receipt {
    position: fixed;
    right: 26px;
    bottom: 66px;
    z-index: 59;
    width: 236px;
    padding: 14px 12px 22px;
    background: #fbfaf5;
    color: #1a1a1a;
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.45);
    transform-origin: bottom center;
    cursor: pointer;
    animation: yg-feed 240ms ease-out;
    -webkit-mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) 50% / 12px 100%;
    mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) 50% / 12px 100%;
  }
  .yg-receipt pre {
    margin: 0;
    font: 600 11px/1.45 ui-monospace, Menlo, Consolas, monospace;
    white-space: pre;
  }
  .yg-receipt.is-torn {
    animation: yg-tear 520ms ease-in forwards;
  }
  @keyframes yg-feed {
    from {
      clip-path: inset(100% 0 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes yg-tear {
    20% {
      transform: rotate(-4deg);
    }
    to {
      transform: translate(-40px, 120px) rotate(-18deg);
      opacity: 0;
    }
  }
  .yg-fab.is-printing {
    animation: yg-buzz 90ms linear infinite;
  }
  @keyframes yg-buzz {
    50% {
      transform: translateX(1px);
    }
  }

  /* ---------- oscilloscope ---------- */
  .yg-scope {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 30;
    width: 24px;
    background: rgba(2, 8, 4, 0.72);
    border-left: 1px solid rgba(57, 255, 136, 0.25);
    pointer-events: none;
  }
  .yg-scope[hidden] {
    display: none;
  }
  .yg-scope canvas {
    display: block;
  }
  .yg-scope__label {
    position: absolute;
    left: 50%;
    top: 12px;
    transform: translateX(-50%) rotate(90deg);
    transform-origin: center;
    color: rgba(57, 255, 136, 0.7);
    font: 600 9px/1 ui-monospace, Menlo, monospace;
    white-space: nowrap;
    margin-top: 28px;
  }
  @media (max-width: 1100px) {
    .yg-scope {
      display: none;
    }
  }

  @media print {
    .yg-root,
    .yg-buddy,
    .yg-sticker-layer {
      display: none !important;
    }
  }
</style>
