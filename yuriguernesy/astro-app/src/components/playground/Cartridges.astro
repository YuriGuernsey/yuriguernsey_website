---
interface Cart {
  title: string;
  href: string;
  excerpt?: string;
  tags?: string[];
}
interface Props {
  carts: Cart[];
}
const { carts } = Astro.props;
const LABELS = ["#ffe600", "#ff4d2e", "#22c55e", "#0ea5e9", "#a855f7", "#f472b6", "#f97316", "#f4f4ef"];
---

<div class="cx">
  <div class="cx-console">
    <div class="cx-tv yg-noinvert">
      <div class="cx-tv__screen">
        <div class="cx-tv__idle">
          <span>INSERT CARTRIDGE</span>
          <small>drag a project into the console, or tap one</small>
        </div>
        <div class="cx-tv__game" hidden>
          <span class="cx-tv__brand">YURI-OS ENTERTAINMENT SYSTEM</span>
          <strong class="cx-tv__title"></strong>
          <p class="cx-tv__excerpt"></p>
          <div class="cx-tv__tags"></div>
          <a class="cx-tv__start" href="#">▶ PRESS START</a>
        </div>
      </div>
    </div>
    <div class="cx-deck">
      <div class="cx-slot" aria-hidden="true"><span class="cx-slot__mouth"></span></div>
      <div class="cx-deck__row">
        <span class="cx-power" aria-hidden="true"></span>
        <span class="cx-deck__name">YES-64</span>
        <button type="button" class="cx-eject" disabled>Eject</button>
      </div>
    </div>
  </div>

  <ul class="cx-shelf" role="list" aria-label="Project cartridges">
    {
      carts.map((c, i) => (
        <li>
          <button
            type="button"
            class="cx-cart"
            style={`--label:${LABELS[i % LABELS.length]}`}
            data-title={c.title}
            data-href={c.href}
            data-excerpt={c.excerpt || ""}
            data-tags={(c.tags || []).slice(0, 3).join("|")}
            aria-label={`Insert ${c.title} cartridge`}
          >
            <span class="cx-cart__grip" aria-hidden="true" />
            <span class="cx-cart__label">
              <span>{c.title}</span>
            </span>
          </button>
        </li>
      ))
    }
  </ul>
</div>

<script>
  function beep(notes: number[], type: OscillatorType = "square") {
    try {
      const Ctx = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
      const ctx = new Ctx();
      const gain = ctx.createGain();
      gain.gain.value = 0.06;
      gain.connect(ctx.destination);
      notes.forEach((f, i) => {
        const o = ctx.createOscillator();
        o.type = type;
        o.frequency.value = f;
        o.connect(gain);
        o.start(ctx.currentTime + i * 0.09);
        o.stop(ctx.currentTime + i * 0.09 + 0.085);
      });
      window.setTimeout(() => ctx.close(), notes.length * 100 + 200);
    } catch {
      /* no sound */
    }
  }

  function initCartridges() {
    const found = document.querySelector<HTMLElement>(".cx");
    if (!found || found.dataset.ready) return;
    const root: HTMLElement = found;
    root.dataset.ready = "1";
    const slot = root.querySelector<HTMLElement>(".cx-slot")!;
    const idle = root.querySelector<HTMLElement>(".cx-tv__idle")!;
    const game = root.querySelector<HTMLElement>(".cx-tv__game")!;
    const screen = root.querySelector<HTMLElement>(".cx-tv__screen")!;
    const eject = root.querySelector<HTMLButtonElement>(".cx-eject")!;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let current: HTMLButtonElement | null = null;

    function ejectCart() {
      if (!current) return;
      current.classList.remove("is-out");
      current = null;
      slot.classList.remove("is-loaded");
      root.classList.remove("is-on");
      game.hidden = true;
      idle.hidden = false;
      eject.disabled = true;
      beep([330, 220], "triangle");
    }

    function insert(cart: HTMLButtonElement) {
      if (current === cart) return;
      if (current) ejectCart();
      current = cart;
      cart.classList.add("is-out");
      slot.style.setProperty("--label", cart.style.getPropertyValue("--label"));
      slot.querySelector<HTMLElement>(".cx-slot__mouth")!.textContent = cart.dataset.title || "";
      slot.classList.remove("is-loaded");
      void slot.offsetWidth;
      slot.classList.add("is-loaded");
      eject.disabled = false;
      beep([110], "sawtooth");

      root.querySelector(".cx-tv__title")!.textContent = cart.dataset.title || "";
      root.querySelector(".cx-tv__excerpt")!.textContent = cart.dataset.excerpt || "";
      const tags = root.querySelector<HTMLElement>(".cx-tv__tags")!;
      tags.innerHTML = "";
      (cart.dataset.tags || "")
        .split("|")
        .filter(Boolean)
        .forEach((t) => {
          const s = document.createElement("span");
          s.textContent = t.replace(/-/g, " ");
          tags.appendChild(s);
        });
      root.querySelector<HTMLAnchorElement>(".cx-tv__start")!.href = cart.dataset.href || "#";

      idle.hidden = true;
      root.classList.remove("is-on");
      screen.classList.remove("is-booting");
      window.setTimeout(
        () => {
          root.classList.add("is-on");
          screen.classList.add("is-booting");
          game.hidden = false;
          beep([523, 659, 784, 1046]);
        },
        reduce ? 0 : 420
      );
    }

    eject.addEventListener("click", ejectCart);

    root.querySelectorAll<HTMLButtonElement>(".cx-cart").forEach((cart) => {
      cart.addEventListener("pointerdown", (e) => {
        if (e.button > 0) return;
        const startX = e.clientX;
        const startY = e.clientY;
        let ghost: HTMLElement | null = null;
        const move = (ev: PointerEvent) => {
          if (!ghost && Math.hypot(ev.clientX - startX, ev.clientY - startY) < 8) return;
          ev.preventDefault();
          if (!ghost) {
            ghost = cart.cloneNode(true) as HTMLElement;
            ghost.classList.add("cx-ghost");
            const r = cart.getBoundingClientRect();
            ghost.style.width = `${r.width}px`;
            ghost.style.height = `${r.height}px`;
            document.body.appendChild(ghost);
            cart.classList.add("is-dragging");
          }
          ghost.style.left = `${ev.clientX}px`;
          ghost.style.top = `${ev.clientY}px`;
          const s = slot.getBoundingClientRect();
          slot.classList.toggle("is-target", ev.clientX > s.left - 40 && ev.clientX < s.right + 40 && ev.clientY > s.top - 80 && ev.clientY < s.bottom + 40);
        };
        const up = () => {
          window.removeEventListener("pointermove", move);
          window.removeEventListener("pointerup", up);
          window.removeEventListener("pointercancel", up);
          cart.classList.remove("is-dragging");
          const hit = slot.classList.contains("is-target");
          slot.classList.remove("is-target");
          if (ghost) {
            ghost.remove();
            if (hit) insert(cart);
          } else {
            insert(cart);
          }
        };
        window.addEventListener("pointermove", move, { passive: false });
        window.addEventListener("pointerup", up);
        window.addEventListener("pointercancel", up);
      });
      cart.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          insert(cart);
        }
      });
      cart.addEventListener("click", (e) => e.preventDefault());
    });
  }
  document.addEventListener("astro:page-load", initCartridges);
  initCartridges();
</script>

<style>
  .cx {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 32px;
    align-items: start;
  }

  /* ---- TV ---- */
  .cx-tv {
    padding: 18px;
    border-radius: 22px;
    background: linear-gradient(180deg, #2a2a2a, #161616);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.06),
      0 20px 40px rgba(0, 0, 0, 0.5);
  }
  .cx-tv__screen {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    display: grid;
    place-items: center;
    padding: 22px;
    border-radius: 18px / 24px;
    background: radial-gradient(ellipse at center, #0d1a12 0%, #040806 80%);
    color: #c8ffd4;
    font-family: ui-monospace, Menlo, Consolas, monospace;
    text-align: center;
    box-shadow: inset 0 0 40px rgba(0, 0, 0, 0.9);
  }
  .cx-tv__screen::after {
    content: "";
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(to bottom, rgba(255, 255, 255, 0.04) 0 1px, transparent 1px 3px);
    pointer-events: none;
  }
  .cx-tv__screen.is-booting {
    animation: cx-crt-on 520ms ease-out;
  }
  @keyframes cx-crt-on {
    0% {
      filter: brightness(3);
      clip-path: inset(49.5% 0 49.5% 0);
    }
    45% {
      clip-path: inset(49.5% 0 49.5% 0);
    }
    100% {
      filter: none;
      clip-path: inset(0 0 0 0);
    }
  }
  .cx-tv__idle {
    display: grid;
    gap: 8px;
  }
  .cx-tv__idle span {
    font-size: clamp(0.9rem, 2.2vw, 1.25rem);
    letter-spacing: 0.12em;
    animation: cx-blink 1.1s steps(2) infinite;
  }
  .cx-tv__idle small {
    color: rgba(200, 255, 212, 0.55);
  }
  @keyframes cx-blink {
    50% {
      opacity: 0.25;
    }
  }
  .cx-tv__idle[hidden],
  .cx-tv__game[hidden] {
    display: none;
  }
  .cx-tv__game {
    display: grid;
    gap: 10px;
    justify-items: center;
    max-width: 30rem;
  }
  .cx-tv__brand {
    color: #ffe600;
    font-size: 0.68rem;
    letter-spacing: 0.18em;
  }
  .cx-tv__title {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-size: clamp(1.5rem, 4vw, 2.6rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    color: #fff;
    text-shadow: 3px 3px 0 #a855f7;
  }
  .cx-tv__excerpt {
    margin: 0;
    color: rgba(200, 255, 212, 0.8);
    font-size: 0.84rem;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .cx-tv__tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
  }
  .cx-tv__tags :global(span) {
    padding: 3px 8px;
    border: 1px solid rgba(200, 255, 212, 0.35);
    border-radius: 999px;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .cx-tv__start {
    margin-top: 6px;
    padding: 8px 14px;
    border-radius: 6px;
    background: #ffe600;
    color: #0b0b0b;
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-decoration: none;
    animation: cx-blink 1.1s steps(2) infinite;
  }
  .cx-tv__start:hover,
  .cx-tv__start:focus-visible {
    animation: none;
  }

  /* ---- console deck ---- */
  .cx-deck {
    position: relative;
    margin: 14px auto 0;
    width: 82%;
    padding: 40px 18px 14px;
    border-radius: 14px 14px 20px 20px;
    background: linear-gradient(180deg, #3a3a3a, #232323);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.12),
      0 14px 30px rgba(0, 0, 0, 0.5);
  }
  .cx-slot {
    position: absolute;
    left: 50%;
    top: 10px;
    width: 56%;
    height: 16px;
    transform: translateX(-50%);
    border-radius: 4px;
    background: #0b0b0b;
    box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.9);
    transition: box-shadow 160ms ease;
  }
  .cx-slot.is-target {
    box-shadow:
      inset 0 2px 4px rgba(0, 0, 0, 0.9),
      0 0 0 2px #ffe600,
      0 0 18px rgba(255, 230, 0, 0.5);
  }
  .cx-slot__mouth {
    position: absolute;
    left: 6%;
    right: 6%;
    bottom: 6px;
    height: 0;
    overflow: hidden;
    display: grid;
    place-items: center;
    border-radius: 3px 3px 0 0;
    background: linear-gradient(var(--label, #ffe600), var(--label, #ffe600)) center 6px / 80% 60% no-repeat, #9a9a9a;
    color: #0b0b0b;
    font: 700 0.6rem/1 "Space Grotesk", system-ui, sans-serif;
    text-transform: uppercase;
    white-space: nowrap;
    transition: height 380ms cubic-bezier(0.3, 1.4, 0.5, 1);
  }
  .cx-slot.is-loaded .cx-slot__mouth {
    height: 34px;
  }
  .cx-deck__row {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .cx-power {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #4a1010;
  }
  .cx.is-on .cx-power {
    background: #ff3b30;
    box-shadow: 0 0 8px #ff3b30;
  }
  .cx-deck__name {
    color: rgba(255, 255, 255, 0.5);
    font: 700 0.72rem/1 "Space Grotesk", system-ui, sans-serif;
    letter-spacing: 0.24em;
  }
  .cx-eject {
    margin-left: auto;
    padding: 6px 12px;
    border: 0;
    border-radius: 999px;
    background: #4b4b4b;
    color: #eee;
    font: 700 0.68rem/1 "Space Grotesk", system-ui, sans-serif;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow: 0 3px 0 #1a1a1a;
  }
  .cx-eject:active {
    transform: translateY(2px);
    box-shadow: 0 1px 0 #1a1a1a;
  }
  .cx-eject:disabled {
    opacity: 0.4;
    cursor: default;
  }

  /* ---- cartridges ---- */
  .cx-shelf {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cx-cart,
  :global(.cx-ghost) {
    position: relative;
    display: grid;
    grid-template-rows: 26px 1fr;
    width: 100%;
    aspect-ratio: 5 / 6;
    padding: 0 10px 12px;
    border: 0;
    border-radius: 10px 10px 4px 4px;
    background: linear-gradient(180deg, #8f8f8f, #6f6f6f);
    box-shadow:
      inset 0 2px 0 rgba(255, 255, 255, 0.25),
      0 6px 0 #4a4a4a,
      0 12px 18px rgba(0, 0, 0, 0.4);
    cursor: grab;
    touch-action: none;
    transition:
      transform 180ms ease,
      opacity 180ms ease;
  }
  .cx-cart:hover,
  .cx-cart:focus-visible {
    transform: translateY(-6px) rotate(-1.5deg);
  }
  .cx-cart.is-out,
  .cx-cart.is-dragging {
    opacity: 0.18;
    transform: translateY(8px);
  }
  :global(.cx-ghost) {
    position: fixed;
    z-index: 90;
    pointer-events: none;
    transform: translate(-50%, -30%) rotate(-6deg) scale(1.05);
    cursor: grabbing;
  }
  .cx-cart__grip {
    margin: 8px 6px 0;
    background: repeating-linear-gradient(90deg, rgba(0, 0, 0, 0.25) 0 3px, transparent 3px 7px);
    border-radius: 2px;
  }
  .cx-cart__label {
    display: grid;
    place-items: center;
    padding: 8px;
    border-radius: 4px;
    background: var(--label);
    color: #0b0b0b;
    box-shadow: inset 0 0 0 2px rgba(0, 0, 0, 0.12);
  }
  .cx-cart__label span {
    font: 700 0.86rem/1.05 "Space Grotesk", system-ui, sans-serif;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-align: center;
    overflow-wrap: anywhere;
  }

  @media (max-width: 980px) {
    .cx {
      grid-template-columns: 1fr;
    }
  }
</style>
